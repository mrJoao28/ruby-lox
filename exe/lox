#!/usr/bin/env ruby
require_relative "../lib/lox"

def run(source, tokens_only: false)
  scanner = Lox::Scanner.new(source)
  tokens = scanner.scan_tokens
  scanner.errors.each { |error| warn "[linha #{error[:line]}] Erro: #{error[:message]}" }
  return false if scanner.errors.any?

  if tokens_only
    tokens.each { |token| puts token }
    return true
  end

  parser = Lox::Parser.new(tokens)
  expr = parser.parse
  parser.errors.each { |error| warn "[linha #{error[:line]}] #{error[:message]}" }
  return false unless expr

  puts Lox::AstPrinter.new.render(expr)
  true
end

tokens_only = !ARGV.delete("--tokens").nil?
path = ARGV.first

if path
  exit(run(File.read(path), tokens_only:) ? 0 : 65)
else
  loop do
    print "> "
    line = $stdin.gets
    break if line.nil?

    run(line.chomp, tokens_only:)
  end
end